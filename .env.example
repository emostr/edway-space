POSTGRES_USER=edway
POSTGRES_PASSWORD=edway
POSTGRES_DB=edway

JWT_SECRET=change-me-in-production

# Публичный адрес платформы. По его схеме определяется флаг Secure у cookie
# сессии: https — ставим, http — нет. Если указать https, а открыть платформу
# по http, Safari выбросит cookie и вход перестанет держаться.
PUBLIC_URL=http://localhost:8020

# Порты 8000 и 8010 на школьном сервере уже заняты ЦСУАМ и «Психолоджиком».
HTTP_PORT=8020
HTTP_BIND=127.0.0.1

# Сколько дней живёт сессия сотрудника.
SESSION_DAYS=90

# ─── Администратор платформы ───────────────────────────────────────────────
# Создаётся при первом запуске: заводит школы, продлевает и закрывает доступ.
# Пустой пароль — сгенерируется и попадёт в журнал контейнера. При первом
# входе платформа потребует сменить его и подключить второй фактор.
# Потеряли доступ: cd backend && npm run admin:reset
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
TOTP_ISSUER=edway.space

# ─── Подписка и оплата ─────────────────────────────────────────────────────
# Стоимость подписки школы на год, в рублях.
PRICE_RUB=14900

# Ключи магазина ЮKassa. Пока их нет, касса работает в учебном режиме: путь
# оплаты проходится целиком, но денег не двигает. В личном кабинете ЮKassa
# укажите адрес для уведомлений: https://ваш-домен/api/billing/webhook
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Передавать ли составом чек. Самозанятому — off: чек формирует сама касса
# через привязку к «Мой налог», и лишний состав в запросе она отвергает.
# on — только если у магазина подключено решение по 54-ФЗ (онлайн-касса).
YOOKASSA_RECEIPT=off

# ─── Защита от перебора ────────────────────────────────────────────────────
# Попыток входа в минуту и регистраций школы за десять минут с одного адреса.
LOGIN_RATE_LIMIT=20
REGISTER_RATE_LIMIT=5

# ─── Реквизиты в документах ────────────────────────────────────────────────
# Попадают в соглашение, политику обработки данных и подвал сайта.
# Меняются только пересборкой образа фронтенда: Next вшивает их в страницы.
CONTACT_EMAIL=hello@edway.space
OPERATOR_NAME=Павлов Матвей Ильич
OPERATOR_STATUS=самозанятый (налог на профессиональный доход)
OPERATOR_INN=583522061051
OPERATOR_ADDRESS=Российская Федерация
OPERATOR_EMAIL=hello@edway.space
DOCS_DATE=3 сентября 2026 года
