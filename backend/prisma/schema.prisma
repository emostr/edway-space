generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ─── Школы и подписки ──────────────────────────────────────────────────────
// Платформа обслуживает много школ сразу. Школа — граница всего: классы,
// тесты, работы и оценки одной школы не видны другой ни при каких условиях.

enum SchoolStatus {
  // Идёт бесплатный период знакомства.
  TRIAL
  // Подписка оплачена и действует.
  ACTIVE
  // Срок вышел: кабинет открывается только на страницу продления.
  EXPIRED
  // Закрыта вручную из панели платформы.
  BLOCKED
}

model School {
  id        String       @id @default(cuid())
  // Название, как его пишет директор: «МБОУ СОШ № 12 г. Твери».
  name      String
  // Короткий адрес школы внутри платформы, из него собираются ссылки.
  slug      String       @unique
  status    SchoolStatus @default(TRIAL)
  city      String       @default("")
  // Контакты для счетов и писем о продлении.
  contactEmail String    @default("")
  contactPhone String    @default("")

  // Докуда оплачено (или докуда идёт пробный период).
  paidUntil DateTime
  // Пометка администратора платформы: кто это и почему заведён вручную.
  note      String       @default("")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accounts     Account[]
  classes      SchoolClass[]
  tests        Test[]
  assignments  Assignment[]
  payments     Payment[]
  mediaFiles   MediaFile[]

  @@index([status])
  @@index([paidUntil])
  @@index([deletedAt])
}

// ─── Учётные записи ────────────────────────────────────────────────────────
// Свободной регистрации нет. Администратор платформы заводит школы, админ
// школы — учителей. Ученики учётных записей не имеют: они пишут на бумаге.

enum AccountRole {
  // Владелец платформы: школы, подписки, платежи. Школы у него нет.
  PLATFORM_ADMIN
  // Директор или завуч: учителя своей школы и оплата подписки.
  SCHOOL_ADMIN
  // Учитель: классы, тесты, проверка работ.
  TEACHER
}

model Account {
  id       String      @id @default(cuid())
  login    String      @unique
  role     AccountRole
  fullName String
  subject  String      @default("")

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  passwordHash String
  // Пока true, дальше экрана смены пароля учётная запись не идёт.
  mustChangePassword Boolean @default(true)
  // Временный пароль показывается тому, кто завёл запись, ровно один раз.
  tempPassword       String?

  // Второй фактор. Для администраторов обязателен, учителю — по желанию.
  totpSecret  String?
  totpEnabled Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions     AuthSession[]
  backupCodes  BackupCode[]
  tests        Test[]
  sharesGiven  TestShare[]   @relation("ShareOwner")
  sharesGot    TestShare[]   @relation("ShareTarget")
  assignments  Assignment[]
  checkedWorks Work[]
  createdClasses SchoolClass[]
  uploads      MediaFile[]

  @@index([schoolId, role])
  @@index([deletedAt])
}

model BackupCode {
  id        String    @id @default(cuid())
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([accountId])
}

model AuthSession {
  id         String    @id @default(cuid())
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  userAgent  String    @default("")
  ip         String    @default("")
  revokedAt  DateTime?

  @@index([accountId])
  @@index([expiresAt])
}

// ─── Оплата ────────────────────────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELED
}

model Payment {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Идентификатор платежа в ЮKassa.
  externalId String        @unique
  status     PaymentStatus @default(PENDING)
  // Сумма в копейках: в рублях с плавающей точкой деньги считать нельзя.
  amount     Int
  currency   String        @default("RUB")
  // За сколько месяцев платят — обычно за год.
  months     Int           @default(12)
  description String       @default("")
  // Кто платил: почта для чека.
  payerEmail String        @default("")

  // Ответ платёжной системы целиком — пригодится при разборе спорных случаев.
  payload Json @default("{}")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  succeededAt DateTime?

  @@index([schoolId, status])
  @@index([createdAt])
}

// ─── Классы и ученики ──────────────────────────────────────────────────────

model SchoolClass {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  number      Int // 1..11
  letter      String // А..Я
  createdById String?
  createdBy   Account?  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?
  // Пустая строка у действующего класса, отметка времени — у сданного в архив:
  // «11А» выпуска 2026 и новый «11А» спокойно живут в одной таблице.
  archiveKey  String    @default("")

  students    Student[]
  assignments Assignment[]

  @@unique([schoolId, number, letter, archiveKey])
  @@index([schoolId, archivedAt])
}

model Student {
  id         String      @id @default(cuid())
  classId    String
  class      SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  lastName   String
  firstName  String
  // Нормализованное «фамилияимя» — по нему ищем дубли при импорте списка.
  searchKey  String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  archivedAt DateTime?

  works Work[]

  @@index([classId, searchKey])
  @@index([archivedAt])
}

// ─── Тесты ─────────────────────────────────────────────────────────────────

enum QuestionType {
  // Один правильный вариант: в бланке одна клетка под букву.
  SINGLE_CHOICE
  // Несколько правильных: в бланке несколько клеток под буквы.
  MULTIPLE_CHOICE
  // Короткий ответ: слово, число или формула — по клетке на символ.
  SHORT_ANSWER
  // Развёрнутый ответ: пишется на отдельном листе, проверяется вручную.
  EXTENDED
}

model Test {
  id           String  @id @default(cuid())
  schoolId     String
  school       School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title        String
  description  String  @default("")
  // Инструкция печатается на бланке и показывается при выдаче.
  instructions String  @default("")
  // Пока тест не опубликован, назначить его классу нельзя.
  isPublished  Boolean @default(false)
  // Сколько вариантов у работы. Ученики получают их по очереди,
  // у каждого варианта свой бланк и свой ключ проверки.
  variantCount Int     @default(1)

  ownerId   String
  owner     Account   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Пороги оценок в процентах от максимума: { "5": 85, "4": 70, "3": 50 }.
  gradeScale Json @default("{\"5\":85,\"4\":70,\"3\":50}")

  questions   Question[]
  shares      TestShare[]
  assignments Assignment[]

  @@index([schoolId, deletedAt])
  @@index([ownerId])
}

model Question {
  id      String       @id @default(cuid())
  testId  String
  test    Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  order   Int
  // 0 — задание идёт во все варианты, 1..N — только в свой.
  variant Int          @default(0)
  type    QuestionType
  // Текст задания из визуального редактора: HTML с формулами KaTeX.
  content String       @default("")
  points  Int          @default(1)

  // Варианты ответа: [{ id, content }] — порядок задаёт буквы А, Б, В…
  options Json @default("[]")
  // Ключ проверки:
  //   SINGLE_CHOICE   { "correct": ["o1"] }
  //   MULTIPLE_CHOICE { "correct": ["o1","o3"], "partial": true }
  //   SHORT_ANSWER    { "accepted": ["Париж"], "caseSensitive": false, "numeric": false, "tolerance": 0 }
  //   EXTENDED        { "guideline": "что засчитывать" }
  answerKey Json @default("{}")

  @@index([testId, order])
  @@index([testId, variant])
}

// Доступ к чужому тесту: владелец делится им с коллегой из своей школы.
model TestShare {
  id        String   @id @default(cuid())
  testId    String
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     Account  @relation("ShareOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Account  @relation("ShareTarget", fields: [teacherId], references: [id], onDelete: Cascade)
  // false — коллега только смотрит и назначает, true — ещё и правит.
  canEdit   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([testId, teacherId])
  @@index([teacherId])
}

// ─── Назначения ────────────────────────────────────────────────────────────

model Assignment {
  id          String      @id @default(cuid())
  schoolId    String
  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  testId      String
  test        Test        @relation(fields: [testId], references: [id], onDelete: Cascade)
  classId     String
  class       SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  date        DateTime    @db.Date
  note        String      @default("")
  createdById String
  createdBy   Account     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  // Проверка завершена: оценки выставлены и попали в журнал.
  closedAt    DateTime?

  // Снимок теста на момент выдачи: задания, баллы, ключи и пороги оценок.
  // Правка теста задним числом не должна менять уже проверенные работы.
  snapshot Json @default("{}")

  works Work[]

  @@unique([testId, classId, date])
  @@index([schoolId, date])
  @@index([classId, date])
}

// ─── Работы ────────────────────────────────────────────────────────────────

enum WorkStatus {
  // Бланк напечатан, работа ещё не загружена.
  PENDING
  // Скан загружен и распознан, но учитель его не подтвердил.
  RECOGNIZED
  // Есть задания, которые платформа не проверяет сама.
  NEEDS_REVIEW
  // Проверена, оценка выставлена.
  CHECKED
}

model Work {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String?
  student      Student?   @relation(fields: [studentId], references: [id], onDelete: SetNull)
  // Запасной бланк без фамилии подписывается от руки, учитель привяжет ученика сам.
  studentName  String     @default("")
  // Код бланка: печатается в углу и читается при загрузке скана.
  code         String     @unique
  // Какой вариант достался ученику. У теста без вариантов всегда 1.
  variant      Int        @default(1)
  status       WorkStatus @default(PENDING)

  pages ScanPage[]

  // Разбор ответов:
  // [{ questionId, type, raw, value, correct, score, maxScore, auto, comment, confidence }]
  answers Json @default("[]")

  autoScore   Int  @default(0)
  manualScore Int  @default(0)
  maxScore    Int  @default(0)
  // Итоговая оценка 2..5 — считается по порогам из снимка теста.
  grade       Int?
  percent     Int  @default(0)

  scannedAt   DateTime?
  checkedAt   DateTime?
  checkedById String?
  checkedBy   Account?  @relation(fields: [checkedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([assignmentId, status])
  @@index([studentId])
}

model ScanPage {
  id        String   @id @default(cuid())
  workId    String
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  // Имя файла в каталоге загрузок (UPLOAD_DIR).
  file      String
  index     Int      @default(0)
  width     Int      @default(0)
  height    Int      @default(0)
  createdAt DateTime @default(now())

  @@index([workId, index])
}

// Картинки, вставленные в текст задания визуальным редактором.
model MediaFile {
  id        String   @id @default(cuid())
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  file      String   @unique
  mime      String   @default("image/webp")
  width     Int      @default(0)
  height    Int      @default(0)
  size      Int      @default(0)
  ownerId   String?
  owner     Account? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([ownerId])
}
