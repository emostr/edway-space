DATABASE_URL="postgresql://edway:edway@localhost:5432/edway?schema=public"
JWT_SECRET="сгенерируйте: openssl rand -base64 48"
PORT=3000
NODE_ENV=development

# Публичный адрес платформы. По его схеме определяется флаг Secure у cookie
# сессии: https — ставим, http — нет.
PUBLIC_URL="http://localhost:3001"

# Разрешённые источники для CORS. В проде не нужно: фронт и API на одном домене.
FRONTEND_ORIGIN="http://localhost:3001"

# Каталог со сканами работ и картинками заданий.
UPLOAD_DIR="./uploads"

# Сколько дней живёт сессия учителя.
SESSION_DAYS=90
