{
  "name": "edway-space-desktop",
  "productName": "edway.space",
  "version": "1.0.0",
  "private": true,
  "description": "edway.space — школьное тестирование, настольное приложение",
  "author": "edway.space <noreply@edway.space>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/emostr/edway-space",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emostr/edway-space.git"
  },
  "main": "dist/main.js",
  "desktopName": "edway-space.desktop",
  "scripts": {
    "build": "tsc && npm run assets",
    "assets": "node scripts/copy-assets.mjs",
    "dev": "npm run build && electron .",
    "pack": "npm run build && node scripts/build-installers.mjs --dir",
    "dist": "npm run build && node scripts/build-installers.mjs",
    "dist:all": "npm run build && node scripts/build-installers.mjs --mac --win --linux",
    "type-check": "tsc --noEmit"
  },
  "edway": {
    "defaultUrl": ""
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "electron": true
  }
}
